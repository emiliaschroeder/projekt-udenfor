---
// Astro.props: kun style
const { style = "h2", stylingclasses = "" } = Astro.props;

// style bestemmer både HTML-tag og Tailwind-classes
const sizeClasses = {
  h1: "text-[90px] md:text-[200px] font-display uppercase tracking-[3px]",
  h2: "text-[64px] md:text-[150px] font-display uppercase",
  h3: "text-[30px] md:text-[55px] font-sans-bold leading-tight",
  h4: "text-[25px] md:text-[40px] font-sans-bold leading-tight",
  cta: "text-[16px] md:text-[22px] font-sans-bold uppercase relative top-[2px] md:top-[3.5px]",
};

const Htmlheading = style;
---

<Htmlheading class:list={[sizeClasses[style], stylingclasses]}>
  <slot />
</Htmlheading>
