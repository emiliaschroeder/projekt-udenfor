---
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Button from "./Button.astro";
---

<div x-data="{ open: false }" x-init="setTimeout(() => open = true, 8000)">
  <!-- Overlay -->
  <div
    x-cloak
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 z-[999]
      flex items-center justify-center
      bg-black/5
      backdrop-blur-[1px]
      p-4"
    @click="open = false"
  >
    <!-- Popup box -->
    <div
      @click.stop
      class="relative
        w-full
        max-w-[285px]
        md:max-w-[500px]
        bg-accent
        border-4 md:border-8 border-secondary
        p-[var(--space-mob-xl)] md:p-[var(--space-desk-lg)]
        text-center
        flex flex-col
        gap-[var(--space-mob-xl)]
        md:gap-[var(--space-desk-lg)]"
    >
      <!-- Headline -->
      <section class="text-secondary leading-tight">
        <Heading style="h3">
          Hjælp en<br class="md:hidden" /> hjemløs i dag
        </Heading>
      </section>

      <!-- Text -->
      <Text style="p">
        Støt med 50 kr./md. - og hjælp et menneske, der lever på gaden.
      </Text>

      <!-- CTA -->
      <section>
        <Button
          class="inline-block cursor-pointer"
          href="/stoet"
          variant="onblue">STØT MED 50 KR./MDR.</Button
        >
      </section>
    </div>
  </div>
</div>
