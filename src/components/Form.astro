---
import Text from "./Text.astro";
import Button from "./Button.astro";
---

<form
  x-data="{
    type: 'fast',
    frequency: 'maanedligt',
    amountPreset: '200',
    payment: 'mobilepay'
  }"
  class="w-full bg-primary p-0"
>
  <!-- TYPE -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">Vælg type af bidrag</Text>

    <div
      class="grid grid-cols-2 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-sm)]"
    >
      <button
        type="button"
        @click="type = 'fast'"
        :class="type === 'fast' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
        :aria-pressed="type === 'fast'"
      >
        Fast donation
      </button>

      <button
        type="button"
        @click="type = 'enkelt'"
        :class="type === 'enkelt' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
        :aria-pressed="type === 'enkelt'"
      >
        Enkelt donation
      </button>
    </div>

    <input type="hidden" name="type" :value="type" />
  </div>

  <!-- FREKVENS -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">Frekvens</Text>

    <div
      class="grid grid-cols-2 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-sm)]"
    >
      <button
        type="button"
        @click="frequency = 'aarligt'"
        :class="frequency === 'aarligt' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        Støt årligt
      </button>

      <button
        type="button"
        @click="frequency = 'maanedligt'"
        :class="frequency === 'maanedligt' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        Støt månedligt
      </button>
    </div>

    <input type="hidden" name="frequency" :value="frequency" />
  </div>

  <!-- BELØB -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">Beløb</Text>

    <div
      class="grid grid-cols-2 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-sm)]"
    >
      <button
        type="button"
        @click="amountPreset = '200'"
        :class="amountPreset === '200' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        200,- kr.
      </button>

      <button
        type="button"
        @click="amountPreset = 'andet'"
        :class="amountPreset === 'andet' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        Andet
      </button>
    </div>

    <!-- Input vises kun ved "Andet" -->
    <div
      x-show="amountPreset === 'andet'"
      x-transition
      class="mt-[var(--space-mob-lg)]"
    >
      <input
        type="number"
        inputmode="numeric"
        name="amount"
        placeholder="Beløb i dkk..."
        :required="amountPreset === 'andet'"
        class="w-full border-2 border-secondary bg-primary px-3 py-2 outline-none"
      />
    </div>

    <!-- Skjulte værdier -->
    <input type="hidden" name="amountPreset" :value="amountPreset" />
    <input
      type="hidden"
      name="amountFixed"
      :value="amountPreset === '200' ? 200 : ''"
    />
  </div>

  <!-- BETALINGSFORM -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">Betalingsform</Text>

    <div
      class="grid grid-cols-2 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-sm)]"
    >
      <button
        type="button"
        @click="payment = 'mobilepay'"
        :class="payment === 'mobilepay' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        MobilePay
      </button>

      <button
        type="button"
        @click="payment = 'kort'"
        :class="payment === 'kort' ? 'border-2 border-secondary' : 'border-2 border-transparent'"
        class="bg-accent py-3 transition"
      >
        Betalingskort
      </button>
    </div>

    <input type="hidden" name="payment" :value="payment" />
  </div>

  <!-- NAVN -->
  <div
    class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)] grid grid-cols-2 gap-[var(--space-mob-lg)]"
  >
    <div>
      <Text style="p" class="mb-[var(--space-mob-sm)]">Fornavn</Text>
      <input
        type="text"
        name="firstname"
        placeholder="..."
        required
        class="w-full border-2 border-secondary bg-primary px-3 py-2 outline-none"
      />
    </div>

    <div>
      <Text style="p" class="mb-[var(--space-mob-sm)]">Efternavn</Text>
      <input
        type="text"
        name="lastname"
        placeholder="..."
        required
        class="w-full border-2 border-secondary bg-primary px-3 py-2 outline-none"
      />
    </div>
  </div>

  <!-- EMAIL -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">E-mail</Text>
    <input
      type="email"
      name="email"
      placeholder="..."
      required
      class="w-full border-2 border-secondary bg-primary px-3 py-2 outline-none"
    />
  </div>
  <!-- Telefon -->
  <div class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)]">
    <Text style="p" class="mb-[var(--space-mob-sm)]">Telefon</Text>
    <input
      type="tel"
      name="phone"
      placeholder="..."
      required
      class="w-full border-2 border-secondary bg-primary px-3 py-2 outline-none"
    />
  </div>
  <!-- Checkboxe -->
  <div
    class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)] space-y-[var(--space-mob-lg)]"
  >
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="terms" class="opacity-100 text-secondary" />
      <Text style="p"> Ja tak, jeg ønsker skattefradrag </Text>
    </label>
  </div>
  <div
    class="mb-[var(--space-mob-xl)] md:mb-[var(--space-desk-lg)] space-y-[var(--space-mob-lg)]"
  >
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="terms" class="opacity-100 text-secondary" />
      <Text style="p">
        Jeg har læst og accepteret vilkår og betingelser for donation
      </Text>
    </label>
  </div>

  <!-- SUBMIT -->
  <Button variant="onsand">DONÉR</Button>
</form>
