---
const { style = "p", stylingclasses = "" } = Astro.props;

const sizeClasses = {
  p: "text-[14px] md:text-[18px] font-sans",

  // bold + italic tekst (emphasis)
  pEm: "text-[14px] md:text-[18px] font-sans-bold italic",
  psmall: "text-[11px] md:text-[16px] font-sans",
};
---

<p class:list={[sizeClasses[style], stylingclasses]}>
  <slot />
</p>
