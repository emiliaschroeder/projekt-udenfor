---
import Heading from "./Heading.astro";
const { title, ...attrs } = Astro.props;
---

<section class="grid grid-cols-6 md:grid-cols-12 md:mb-[var(--space-desk-xl)]">
  <!-- animation wrapper -->
  <div
    {...attrs}
    class={`col-start-2 col-span-4 md:col-start-2 md:col-span-10 opacity-0 ${Astro.props.class ?? ""}`}
  >
    <!-- Title -->
    <div class="mb-[var(--space-mob-md)]">
      <Heading style="h4" stylingclasses="text-secondary">
        {title}
      </Heading>
    </div>

    <!-- Cards -->
    <div data-stagger class="grid md:grid-cols-3 md:gap-[var(--space-desk-xl)]">
      <slot />
    </div>
  </div>
</section>
