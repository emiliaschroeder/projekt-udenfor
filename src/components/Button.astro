---
import Heading from "./Heading.astro";

// Props
const {
  variant = "onsand",
  href,
  ariaLabel,
  target,
  rel,
  type = "button",
} = Astro.props;

const buttonStyling = "inline-flex justify-center items-center leading-none";

const variantClasses = {
  onsand:
    "px-7 py-2 md:px-16 md:py-3 bg-accent text-secondary shadow-[var(--shadow-offset-sm)_var(--color-secondary)] md:shadow-[var(--shadow-offset-md)_var(--color-secondary)] hover:bg-secondary hover:text-accent hover:shadow-[var(--shadow-offset-md)_var(--color-accent)]",
  onred:
    "px-7 py-2 md:px-16 md:py-3 bg-accent text-secondary shadow-[var(--shadow-offset-sm)_var(--color-primary)] md:shadow-[var(--shadow-offset-md)_var(--color-primary)] hover:bg-primary hover:text-secondary hover:shadow-[var(--shadow-offset-md)_var(--color-accent)]",
  onblue:
    "px-7 py-2 md:px-16 md:py-3 bg-primary text-secondary shadow-[var(--shadow-offset-sm)_var(--color-secondary)] md:shadow-[var(--shadow-offset-md)_var(--color-secondary)] hover:bg-secondary hover:text-primary hover:shadow-[var(--shadow-offset-md)_var(--color-primary)]",
  btnmenu:
    "w-28 h-8 md:w-36 md:h-12 px-7 py-2 md:px-9 md:py-2.5 bg-accent text-secondary shadow-[var(--shadow-offset-xs)_var(--color-primary)] md:shadow-[var(--shadow-offset-sm)_var(--color-primary)] hover:bg-primary hover:text-secondary hover:shadow-[var(--shadow-offset-sm)_var(--color-accent)]",
};

// sikker fallback hvis variant er forkert
const classes = [
  buttonStyling,
  variantClasses[variant] ?? variantClasses.onsand,
];

// hvis target="_blank", så sæt en sikker default rel
const computedRel =
  target === "_blank" ? (rel ? rel : "noopener noreferrer") : rel;
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      aria-label={ariaLabel}
      target={target}
      rel={computedRel}
    >
      <Heading style="cta">
        <slot />
      </Heading>
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={ariaLabel}>
      <Heading style="cta">
        <slot />
      </Heading>
    </button>
  )
}
