---
import Heading from "./Heading.astro";
import Button from "./Button.astro";
---

<section
  class="bg-secondary text-primary mb-[var(--space-mob-xxl)] my:mb-[var(--space-desk-xl)]"
>
  <div class="align-center px-14 py-8 md:pr-180 md:pl-30 md:pt-15 md:pb-0">
    <Heading style="h4"><slot /></Heading>
  </div>

  <div
    class="flex justify-end items-center pb-10 px-12 gap-7 -mt-0 md:-mt-12 md:pb-15 md:gap-10"
  >
    <img
      src="/img/arrow_white.svg"
      alt="white arrow"
      class="w-18 h-3 md:w-56 md:h-8"
    />
    <Button href="/stoet" variant="onred">Donér</Button>
  </div>
</section>
