---
const {
  title,
  img,
  alt_tekst,
  number,
  job,
  mail,
  animate = false,
  ...attrs
} = Astro.props;

import Text from "./Text.astro";
import Link from "./Link.astro";
---

<article
  {...attrs}
  data-animate={animate || undefined}
  class={`mb-[var(--space-mob-xxl)] opacity-0 ${Astro.props.class ?? ""}`}
>
  <!-- Card: billede start -->
  <img
    src={img}
    alt={alt_tekst ?? title}
    class="w-full object-cover mb-[var(--space-mob-sm)] self-stretch h-72 md:h-96 md:mb-[var(--space-desk-xs)]"
  />
  <!-- Card: billede slut -->

  <!-- Card: navn + job start -->
  <Text style="p" stylingclasses="text-secondary font-sans-bold"> {title}</Text>
  <Text style="p" stylingclasses="text-secondary mb-[var(--space-mob-sm)] ">
    {job}</Text
  >
  <!-- Card: navn + job slut -->

  <!-- Card: kontakt start -->
  <div class="flex flex-col gap-[var(--space-mob-xxs)]">
    <Link href={`mailto:${mail}`} variant="secondary">{mail}</Link>
    <Link href={`tel:${number}`} variant="secondary">tlf: {number}</Link>
  </div>
  <!-- Card: kontakt slut -->
</article>
