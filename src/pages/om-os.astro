          alt="Person der sover på gaden"
          class="w-full md:w-[800px] pl-10 md:pl-0 md:mt-[-100px]"
        />
      </div>
      <!-- Hero: billede slut -->
    </section>
    <!-- OM OS – HERO INTRO SLUT -->

    <!--  HISTORIE HERO START  -->
    <section
      class="bg-secondary col-span-full grid grid-cols-6 md:grid-cols-12
         pt-20 pb-10 -mt-10
         md:-mt-40 md:pb-20
         mb-[var(--space-mob-xxl)] md:mb-[var(--space-desk-md)]"
