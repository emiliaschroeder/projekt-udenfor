          class="col-span-full bg-secondary relative overflow-hidden
            h-[496px]
            md:h-[558px] md:pl-[var(--space-desk-md)]"
        >
          <!-- Hero: indhold start -->
          <div class="grid grid-cols-6 md:grid-cols-12 h-full relative">
