<MainLayout title="Om os">
  <main>
    <section>
      <div class="grid grid-cols-6 md:grid-cols-12">
        <!-- Hero: H2 start -->
        <div
          class="col-start-1 pl-[var(--space-desk-md)] col-span-4 md:col-start-1 md:col-span-12 text-secondary md:pl-[var(--space-desk-md)]"
        >
          <Heading style="h2">OM OS</Heading>
        </div>
        <!-- Hero: H2 slut -->

        <!-- Hero: container start -->
