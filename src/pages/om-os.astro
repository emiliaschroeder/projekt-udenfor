        <div class="grid grid-cols-6 md:grid-cols-12 items-end md:pl-10">
          <!-- Hero: titel start -->
          <div class="col-span-full md:col-span-7 text-secondary">
            <Heading style="h2">Om os</Heading>
          </div>
          <!-- Hero: titel slut -->
        </div>
      </div>
      <!-- Hero: titel-wrapper slut -->

      <!-- Hero: billede start -->
      <div
        class="col-span-full md:col-start-4 md:flex md:justify-end
           relative z-10 md:z-30"
      >
        <img
