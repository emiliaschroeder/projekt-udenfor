<MainLayout title="Om os">
  <main>
    <!-- OM OS – HERO INTRO START -->
    <section class="col-span-full bg-primary">
      <!-- Hero: titel-wrapper start -->
      <div
        class="col-span-full px-[var(--space-mob-md)]
           md:px-0 md:col-start-2 md:col-span-10"
