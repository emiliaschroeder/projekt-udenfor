                 pt-[var(--space-mob-xl)]
                  md:mt-[var(--space-desk-xl)]"
            >
              <div>
                <!-- Hero: overskrift start -->
                <Heading style="h4">Projekt Udenfors historie</Heading>
                <!-- Hero: overskrift slut -->
              </div>

              <!-- Hero: brødtekst start -->
