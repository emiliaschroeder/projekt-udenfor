---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Form from "../components/Form.astro";
import TextBox from "../components/TextBox.astro";
---

<MainLayout title="Støt">
  <main class="grid grid-cols-6 md:grid-cols-12">
    <!-- Start hero -->
    <section class="col-span-full bg-primary">
      <div
        class="col-span-full px-[var(--space-mob-md)] md:px-0 md:col-start-2 md:col-span-10"
      >
        <div class="grid grid-cols-6 md:grid-cols-12 items-end md:pl-10">
          <!-- Tekst -->
          <div
            class="col-span-full md:col-span-7 text-secondary leading-tight pt-5 md:pt-10"
          >
            <Heading style="h2">STØT VORES ARBEJDE</Heading>
          </div>
        </div>
      </div>
      <!-- Billede -->
      <div
        class="col-span-full md:col-start-4 md:flex md:justify-end relative z-10 md:z-30"
      >
        <img
          src="/img/liggende_cutout_sand.svg"
          alt="Person der sover på gaden"
          class="w-full md:w-[800px] pl-10 md:pl-0 md:mt-[-170px]"
        />
      </div>
    </section>
    <!-- Slut hero -->

    <!-- Start indhold + form -->
    <section class="col-span-full bg-secondary mt-[-30px] md:mt-[-70px]">
      <div
        class="col-start-2 col-span-4 md:col-start-2 md:col-span-9 py-[var(--space-mob-xxl)] md:py-[var(--space-desk-xl)]"
      >
        <div
          class="grid grid-cols-6 md:grid-cols-12 gap-[var(--space-mob-xxl)] md:gap-[var(--space-desk-xl)]"
        >
          <!-- Venstre kolonne -->
          <section
            class="col-start-2 col-span-4 md:col-start-2 md:col-span-5 text-primary"
          >
            <Heading style="h4"
              >Hjælp os med at <br />forbedre vilkårene</Heading
            >
            <div class="mt-[var(--space-mob-sm)] md:mt-[var(--space-desk-sm)]">
              <Text
                style="p"
                stylingclasses="text-white"
                class="mt-[var(--space-mob-lg)]"
              >
                I Projekt Udenfor er vi afhængige af private og offentlige
                bidrag for at kunne forbedre vilkårene for personer i
                gadehjemløshed.
              </Text>
            </div>

            <!-- Digtsamlinger -->
            <div
              class="my-[var(--space-mob-xl)] md:mt-[var(--space-desk-lg)] grid grid-cols-2 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-sm)]"
            >
              <img
                src="/img/digt_1.png"
                alt="Fiasko digtsamling"
                class="w-full h-550px"
              />
              <img
                src="/img/digt_2.png"
                alt="Dejlig deprimeret digtsamling"
                class="w-full h-550px"
              />
            </div>
            <Heading
              style="h4"
              class="mt-[var(--space-mob-xxl)] md:mt-[var(--space-desk-lg)]"
            >
              Støt og modtag 2 gratis digtsamlinger
            </Heading>

            <div class="mt-[var(--space-mob-sm)] md:mt-[var(--space-desk-sm)]">
              <Text style="p" stylingclasses="text-white">
                Du kan hjælpe os med at forbedre forholdene for hjemløse
                borgere, som lever på gaden. Lige nu sender vi dig to
                digtsamlinger skrevet af mennesker med hjemløshedserfaring som
                tak for en donation på 200 kroner. MobilePay dem på 345 203 med
                teksten “digt”, og skriv adressen i en mail på info@udenfor.dk
              </Text>
            </div>
          </section>

          <!-- Højre kolonne (form) -->
          <aside
            class="col-span-full md:col-start-7 md:col-span-6 px-5 md:px-0"
          >
            <div
              class="bg-primary px-[var(--space-mob-md)] py-[28px] md:p-[var(--space-desk-lg)] md:mt-[120px]"
            >
              <Form />
            </div>

            <!-- Persondata -->
            <div
              class="gap-[var(--space-mob-sm)] md:gap-[var(--space-desk-sm)] mt-[var(--space-mob-md)] md:mt-[var(--space-desk-md)] text-white"
            >
              <Text style="p">Persondata</Text>

              <Text style="p-small">
                Hos Projekt Udenfor behandler vi dine personoplysninger i
                henhold til EU's Databeskyttelsesforordning og den danske
                Databeskyttelseslov.
              </Text>

              <Link variant="primary" href="#"
                >Læs vores persondatapolitik her</Link
              >
              <br />
              <Link variant="primary" href="#">Læs vores betingelser her</Link>
            </div>
          </aside>
        </div>
      </div>
    </section>
    <!-- Start indhold + form -->
    <section class="col-span-full bg-primary">
      <div class="grid grid-cols-6 md:grid-cols-12">
        <div class="col-span-full md:col-start-2 md:col-span-10">
          <div
            class="grid grid-cols-6 md:grid-cols-12
               py-[var(--space-mob-xxl)] md:py-[var(--space-desk-xl)]"
          >
            <!-- INDHOLD WRAPPER: midt på mobil -->
            <div
              class="col-start-2 col-span-4
                 md:col-start-1 md:col-span-12
                 grid grid-cols-1 md:grid-cols-12
                 gap-[var(--space-mob-lg)] md:gap-[var(--space-desk-xl)]"
            >
              <!-- TEKST + LISTE -->
              <div class="md:col-span-6 text-black">
                <Heading style="h4" stylingclasses="text-secondary"
                  >Din donation går til :</Heading
                >

                <ul
                  class="mt-[var(--space-mob-sm)] md:mt-[var(--space-desk-lg)]
                     space-y-[var(--space-mob-xl)] md:space-y-[var(--space-desk-md)]"
                >
                  <li class="flex items-start gap-[var(--space-mob-lg)]">
                    <img
                      src="/img/arrow_black.svg"
                      alt=""
                      aria-hidden="true"
                      class="mt-3 w-10 shrink-0"
                    />
                    <div>
                      <Text style="pEm">Livsnødvendigheder</Text>
                      <Text style="p">som soveposer, telte, og mad.</Text>
                    </div>
                  </li>

                  <li class="flex items-start gap-[var(--space-mob-lg)]">
                    <img
                      src="/img/arrow_black.svg"
                      alt=""
                      aria-hidden="true"
                      class="mt-3 w-8 shrink-0"
                    />
                    <div>
                      <Text style="pEm"
                        >Akut hjælp og midlertidige overnatninger</Text
                      >
                      <Text style="p">i nødsituationer.</Text>
                    </div>
                  </li>

                  <li class="flex items-start gap-[var(--space-mob-lg)]">
                    <img
                      src="/img/arrow_black.svg"
                      alt=""
                      aria-hidden="true"
                      class="mt-3 w-8 shrink-0"
                    />
                    <div>
                      <Text style="pEm">Aktiviteter og små oplevelser</Text>
                      <Text style="p">der giver livskvalitet og nærvær.</Text>
                    </div>
                  </li>

                  <li class="flex items-start gap-[var(--space-mob-lg)]">
                    <img
                      src="/img/arrow_black.svg"
                      alt=""
                      aria-hidden="true"
                      class="mt-3 w-8 shrink-0"
                    />
                    <div>
                      <Text style="pEm">Opsøgende gadeplansarbejde</Text>
                      <Text style="p">direkte på gaden.</Text>
                    </div>
                  </li>
                </ul>
              </div>

              <!-- BILLEDE (samme midterkolonner på mobil) -->
              <figure class="md:col-span-6 md:flex md:justify-end">
                <img
                  src="/public/img/måltid.png"
                  alt="Et måltid bliver rakt frem"
                  class="w-full"
                />
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Start Tekst -->
    <section class="col-start-2 col-span-4 md:col-start-2 md:col-span-10">
      <section
        class="md:grid md:grid-cols-12 mt-[var(--space-mob-sm)] md:mt-[var(--space-desk-sm)]"
      >
        <div class="md:col-start-1">
          <TextBox
            sectionTitle="Andre donationer"
            body="Ønsker du at donere naturalier til Projekt Udenfor, så kontakt os på info@udenfor.dk eller 33427600. Hvis vi af den ene eller anden årsag ikke er den rette modtager af donationen, kan vi måske guide dig til et andet sted, der kunne drage nytte af dit overskud."
          />
        </div>
        <div class="md:col-start-1 md:col-span-full md:grid md:grid-cols-5">
          <div class="md:col-start-1 md:col-span-2">
            <img
              src="/img/gave.png"
              alt=""
              class="w-full md:w-96 md:h-[604px] pb-[var(--space-mob-xxl)] md:pb-[var(--space-desk-xl)]"
            />
          </div>
          <div class="md:col-start-3 md:col-span-3">
            <TextBox
              sectionSubtitle="Donér din fødselsdag"
              body="Lejlighedsvis - og til stor glæde og gavn på gaden - oplever vi, at privatpersoner vælger at bede deres fødselsdags-, bryllups-, eller receptionsgæster om et bidrag til vores arbejde, fremfor at købe gaver, vin eller blomster. Kunne du tænke dig at lade overskuddet fra din begivenhed gå til et godt formål, er du velkommen til at kontakte os på info@udenfor.dk"
            />
            <TextBox
              sectionSubtitle="Gratis testamente"
              body="Projekt Udenfors arbejde med viden og formidling har til formål at sikre opmærksomhed på gadehjemløshed, påvirke den offentlige debat på hjemløseområdet og sikre at holdninger, handlinger og indsatser overfor målgruppen tager form på et nuanceret og oplyst grundlag."
              buttonText="Opret"
            />
          </div>
        </div>

        <div class="md:col-start-1 md:col-span-full md:grid md:grid-cols-5">
          <div class="md:col-start-1 md:col-span-2">
            <img
              src="/img/frivillig.png"
              alt=""
              class="w-full md:w-96 md:h-[604px] pb-[var(--space-mob-xxl)] md:pb-[var(--space-desk-xl)]"
            />
          </div>
          <div class="md:col-start-3 md:col-span-3">
            <div>
              <TextBox
                sectionSubtitle="Frivilligt arbejde"
                body="Du kan også støtte vores arbejde ved at engagere dig som frivillig i Den Mobile Café."
                buttonText="Læs mere"
              />
            </div>
            <div>
              <TextBox
                sectionSubtitle="Bliv klogere og del"
                body="Du kan understøtte vores arbejde ved at følge os på vores sociale medier og dele vores indlæg i dit netværk. Du finder os på Facebook, Instagram og LinkedIn, ligesom du kan tilmelde dig vores nyhedsbrev her."
              />
            </div>
            <TextBox sectionSubtitle="Tak for din støtte!" />
          </div>
        </div>
      </section>
    </section>
    <!-- Slut Tekst -->
  </main>
</MainLayout>
