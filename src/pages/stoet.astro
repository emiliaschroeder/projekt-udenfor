---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Button from "../components/Button.astro";
import PopUp from "../components/PopUp.astro";
import Form from "../components/Form.astro";
---

<MainLayout title="Titel">
  <main class="container mx-auto p-4">
    <Heading style="h2">Støt vores arbejde</Heading>
    <img src="/public/img/liggende_cutout_sand.svg" alt="hjemløs" />
    <Heading style="h4">Hjælp os med at forbedre vilkårene</Heading>
    <Text style="p">
      I Projekt Udenfor er vi afhængige af private og offentlige bidrag for at
      kunne forbedre vilkårene for personer i gadehjemløshed. Heading
      style="h4">Hjælp os med at forbedre vilkårene</Text
    >
    <Heading style="h4">Støt og modtag 2 gratis digtsamlinger</Heading>

    <Text style="p">
      Du kan hjælpe os med at forbedre forholdene for hjemløse borgere, som
      lever på gaden. Lige nu sender vi dig to digtsamlinger skrevet af
      mennesker med hjemløshedserfaring som tak for en donation på 200 kroner.
      Mobilepay dem på 345 203 med teksten ”digt”, og skriv adressen i en mail
      på info@udenfor.dk
    </Text>
    <img src="/public/img/digt_1.png" alt="Fiasko digtsamling" />
    <img src="/public/img/digt_2.png" alt="Dejlig deprimeret digtsamling" />
    <Form />

    <Text style="p-small">Persondata </Text>
    <Text style="p-small"
      >Hos Projekt Udenfor behandler vi dine personoplysninger i henhold til
      EU's Databeskyttelsesforordning og den danske Databeskyttelseslov.
    </Text>
  </main>
</MainLayout>
