---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import HistorieCard from "../components/HistorieCard.astro";
import Banner from "../components/Banner.astro";
import TextBox from "../components/TextBox.astro";
---

<MainLayout title="Titel">
  <main class="grid grid-cols-6 md:grid-cols-12">
    <!-- Start Hero -->

    <div
      class="bg-secondary col-span-full text-primary py-3 leading-none flex justify-center md:justify-start md:pl-10 z-10 md:-mt-10 md:pb-0"
    >
      <Heading style="h1">Projekt</Heading>
    </div>
    <div
      class="text-secondary col-span-full leading-none py-3 flex justify-center md:justify-end md:pr-15 md:-mt-5"
    >
      <Heading style="h1">Udenfor</Heading>
    </div>

    <div
      class="w-72 col-span-full text-right ml-auto mr-10 md:ml-auto md:mr-15 md:w-[539px] pt-[var(--space-mob-lg)] md:pt-[var(--space-desk-lg)]"
    >
      <div
        class="text-secondary pb-[var(--space-mob-md)] md:pb-[var(--space-desk-xs)]"
      >
        <Heading style="h4">Vi hjælper samfundets mest udstødte</Heading>
      </div>
      <Button variant="onsand">Støt</Button>
    </div>
    <img
      src="/img/index_hero_mobil.png"
      alt=""
      class="block col-span-full md:hidden w-[533.57px] h-[574.02px] -mt-20 z-5"
    />
    <img
      src="/img/index_hero.png"
      alt=""
      class="hidden col-span-full md:block md:w-[750px] -mt-172 z-5"
    />
    <!-- Slut Hero -->

    <!-- Start rød sektion -->
    <section
      class="bg-secondary relative col-span-full -mt-15 pt-30 pb-35 md:pt-18 md:pb-10 md:-mt-17 flex justify-center md:justify-start md:grid md:grid-cols-12"
    >
      <div class="w-72 text-left md:w-[808px] md:col-start-2">
        <div
          class="text-primary leading-tight pb-[var(--space-mob-sm)] md:pb-[var(--space-desk-xs)]"
        >
          <Heading style="h3">Hvad er Projekt Udenfor?</Heading>
        </div>
        <div class="text-white md:w-[691px] md:mb-[var(--space-desk-sm)]">
          <Text>
            I Projekt Udenfor arbejder vi for at forbedre forholdene for
            samfundets absolut udstødte. Det gør vi ved at kombinere opsøgende
            gadeplansarbejde med indsamling og formidling af viden om
            hjemløshed.
          </Text>
        </div>
        <img
          src="/img/logo.svg"
          alt=""
          class="w-26 h-26 absolute top-19 right-7 md:hidden"
        />
        <img
          src="/img/logo.svg"
          alt=""
          class="hidden md:block md:w-40 md:h-40 -ml-7"
        />
      </div>
    </section>

    <div
      class="col-span-full -mt-25 relative ml-3 md:-mt-65 md:ml-120 mb-[var(--space-mob-md)] md:mb-[var(--space-desk-md)]"
    >
      <img
        src="/img/liggende_cutout.png"
        alt=""
        class="z-5 w-[433.5px] h-[141px] md:w-[1065px] md:h-80"
      />
    </div>

    <!-- Slut rød sektion -->

    <!-- Start ScrollBar sektion -->

    <section
      class="col-start-2 col-span-4 md:col-start-2 md:col-span-10 mb-[var(--space-mob-lg)] md:mb-[var(--space-desk-md)]"
    >
      <div>
        <div
          class="text-secondary leading-tight pb-[var(--space-mob-sm)] md:pb-[var(--space-desk-xs)]"
        >
          <Heading style="h3"> Fortællinger fra gaden </Heading>
        </div>
        <div class="w-[279px] md:w-[691px]">
          <Text>
            Gadesovere er mennesker i hjemløshed, der lever og overnatter på
            gaden. Selv i årets koldeste måneder sover de udenfor eller søger læ
            i trappeopgange, parkeringskældre, under broer eller i et telt i en
            skov.
          </Text>
        </div>
      </div>
    </section>

    <section
      class="relative col-span-full md:col-span-full mb-[var(--space-mob-xxl)] my:mb-[var(--space-desk-xl)]"
    >
      <div
        class="flex overflow-x-auto pl-7 md:pl-30 gap-10 md:gap-[var(--space-desk-xl)] pb-5 md:pb-15 no-scrollbar"
      >
        <HistorieCard img="/img/kristian.png" title="Kristian" />
        <HistorieCard img="/img/steen.png" title="Steen" />
        <HistorieCard img="/img/julie.png" title="Julie" />
        <HistorieCard img="/img/oliver.png" title="Oliver" />
        <HistorieCard img="/img/tristan.png" title="Tristan" />
        <HistorieCard img="/img/sandy.png" title="Sandy" />
      </div>
    </section>
    <!-- Slut ScrollBar sektion -->
    <!-- Start Banner -->
    <div class="col-span-full md:col-span-12">
      <Banner
        >Godt en tredjedel af alle borgere i hjemløshed er unge mellem 18 og 29
        år.</Banner
      >
    </div>
    <!-- Slut Banner -->

    <!-- Start Tekst -->
    <section class="col-start-2 col-span-4 md:col-start-2 md:col-span-10">
      <section class="md:grid md:grid-cols-12">
        <div class="md:col-start-1">
          <TextBox
            sectionTitle="Hvad vi gør"
            lead="Vi møder mennesker dér, hvor de er – på gaden."
            body="I Projekt Udenfor har vi respekt for det enkelte menneskes ret til at vælge livsform, og vi gør os ikke til dommere over, hvordan det gode liv ser ud. Men vi mener, at der er måder at leve på, som ikke er værdige, og som kræver, at vi eller andre forholder sig til de betingelser, der leves under."
          />
        </div>
        <div class="md:col-start-1 md:col-span-full md:grid md:grid-cols-5">
          <div class="md:col-start-1 md:col-span-2">
            <img
              src="/img/gadevogn.png"
              alt=""
              class="w-full md:w-96 md:h-[604px] pb-[var(--space-mob-xxl)] md:pb-[var(--space-desk-xl)]"
            />
          </div>
          <div class="md:col-start-3 md:col-span-3">
            <TextBox
              sectionSubtitle="Gadeplansarbejde"
              body="I dagens, aftenens og nattens timer er Projekt Udenfor på gaden i København. Vi observerer byen og stiller os til rådighed overfor de dårligst stillede hjemløse borgere. Gadeplansindsatsen er rettet mod hjemløse gadesovere, der ikke får den hjælp, de har behov for, i de etablerede offentlige systemer."
              buttonText="Læs mere"
            />
            <TextBox
              sectionSubtitle="Videns- og formidlingsarbejde"
              body="Projekt Udenfors arbejde med viden og formidling har til formål at sikre opmærksomhed på gadehjemløshed, påvirke den offentlige debat på hjemløseområdet og sikre at holdninger, handlinger og indsatser overfor målgruppen tager form på et nuanceret og oplyst grundlag."
              buttonText="Læs mere"
            />
          </div>
        </div>

        <div class="md:col-start-1 md:col-span-full md:grid md:grid-cols-5">
          <div class="md:col-start-1 md:col-span-2">
            <img
              src="/img/denmobilecafe.png"
              alt=""
              class="w-full md:w-96 md:h-[604px] pb-[var(--space-mob-xxl)] md:pb-[var(--space-desk-xl)]"
            />
          </div>
          <div class="md:col-start-3 md:col-span-3">
            <div>
              <TextBox
                sectionSubtitle="Den Mobile Café"
                body="Som et vigtigt og fast supplement til det professionelle, opsøgende gadeplansarbejde, driver Projekt Udenfor Den Mobile Café. Her serverer en gruppe af frivillige dagligt et måltid mad til gadens folk."
                buttonText="Læs mere"
              />
            </div>
            <div>
              <TextBox
                sectionSubtitle="Eksperimenterende projekter"
                body="Derudover udvikler og igangsætter organisationen løbende eksperimenterende og tidsbegrænsede projekter, der tager udgangspunkt i aktuelle problematikker på hjemløseområdet. Projekt Udenfors opgave er ikke, og må aldrig blive, at udføre varigt og etableret socialt arbejde. Derimod arbejder vi bevidst med at gå foran og afprøve nye initiativer, som efterfølgende kan overtages og drives af andre aktører."
                buttonText="Læs mere"
              />
            </div>
          </div>
          <div class="md:col-start-3 md:col-span-3">
            <TextBox
              sectionSubtitle="Internationalt arbejde"
              body="I forlængelse af Projekt Udenfors arbejde på både gade- og formidlingsplan er vi internationalt engagerede og bidrager aktivt i tværeuropæiske netværk, erfaringsudvekslingsfora og lobbyarbejde, der har til formål at stoppe hjemløshed på europæisk niveau"
              buttonText="Læs mere"
            />
          </div>
        </div>
      </section>
    </section>
    <!-- Slut Tekst -->
  </main>
</MainLayout>
